<%- include('../partials/header') %>
<% const staff = usuario.rol === 'admin' || usuario.rol === 'agente'; %>
<div class="encabezado">
  <div>
    <p class="migas"><a href="/tickets">Tickets</a> / #<%= ticket.idticket %></p>
    <h1><%= ticket.titulo %></h1>
    <p>
      <span class="etiqueta estado-<%= ticket.estado %>"><%= etiquetaEstado(ticket.estado) %></span>
      <span class="etiqueta prioridad-<%= ticket.prioridad %>"><%= etiquetaPrioridad(ticket.prioridad) %></span>
      <span class="texto-suave">· <%= ticket.categoria %></span>
    </p>
  </div>
  <div class="acciones">
    <a class="btn btn-secundario" href="/tickets/<%= ticket.idticket %>/editar">Editar</a>
    <% if (staff) { %>
      <form method="post" action="/tickets/<%= ticket.idticket %>/eliminar" onsubmit="return confirm('¿Eliminar el ticket #<%= ticket.idticket %> y sus comentarios?');">
        <button class="btn btn-peligro" type="submit">Eliminar</button>
      </form>
    <% } %>
  </div>
</div>

<section class="dos-columnas">
  <div class="tarjeta">
    <h2>Descripción</h2>
    <p class="texto-largo"><%= ticket.descripcion %></p>
    <% if (preguntas.length) { %>
      <h3>Respuestas rápidas</h3>
      <ul>
        <% preguntas.forEach(function (p) { %>
          <li><strong><%= p.pregunta %></strong> <%= p.opcion_seleccionada %></li>
        <% }) %>
      </ul>
    <% } %>
  </div>

  <div class="tarjeta">
    <h2>Datos del ticket</h2>
    <table class="tabla tabla-simple">
      <tr><td>Solicitante</td><td><strong><%= ticket.solicitante %></strong><br><small class="texto-suave"><%= ticket.correo_solicitante %></small></td></tr>
      <tr><td>Agente asignado</td><td><%= ticket.agente || 'Sin asignar' %></td></tr>
      <tr><td>Creado</td><td><%= fmtFecha(ticket.fecha_creacion) %></td></tr>
      <tr><td>Cierre</td><td><%= fmtFecha(ticket.fecha_cierre) %></td></tr>
    </table>

    <% if (staff) { %>
      <h3>Gestionar</h3>
      <form method="post" action="/tickets/<%= ticket.idticket %>/estado" class="formulario">
        <label>Estado
          <select name="estado">
            <% ESTADOS.forEach(function (e) { %>
              <option value="<%= e %>" <%= ticket.estado === e ? 'selected' : '' %>><%= etiquetaEstado(e) %></option>
            <% }) %>
          </select>
        </label>
        <label>Agente
          <select name="id_agente">
            <option value="">Sin asignar</option>
            <% agentes.forEach(function (a) { %>
              <option value="<%= a.idusuarios %>" <%= ticket.id_agente === a.idusuarios ? 'selected' : '' %>><%= a.nombre %></option>
            <% }) %>
          </select>
        </label>
        <button class="btn btn-primario" type="submit">Actualizar</button>
      </form>
    <% } %>
  </div>
</section>

<section class="tarjeta" id="comentarios">
  <h2>Comentarios (<%= comentarios.length %>)</h2>
  <% if (!comentarios.length) { %>
    <p class="texto-suave">Todavía no hay comentarios. Escribe el primero.</p>
  <% } %>
  <% comentarios.forEach(function (c) { %>
    <article class="comentario <%= c.rol_autor === 'solicitante' ? '' : 'comentario-staff' %>">
      <header>
        <strong><%= c.autor %></strong>
        <span class="etiqueta rol-<%= c.rol_autor %>"><%= etiquetaRol(c.rol_autor) %></span>
        <span class="texto-suave"><%= fmtFecha(c.fecha) %></span>
        <% if (usuario.rol === 'admin' || c.id_usuario === usuario.id) { %>
          <form method="post" action="/comentarios/<%= c.id_comentarios %>/eliminar" class="en-linea" onsubmit="return confirm('¿Eliminar este comentario?');">
            <button class="btn btn-enlace btn-chico" type="submit">Eliminar</button>
          </form>
        <% } %>
      </header>
      <p class="texto-largo"><%= c.mensaje %></p>
    </article>
  <% }) %>

  <form method="post" action="/tickets/<%= ticket.idticket %>/comentarios" class="formulario">
    <label>Agregar comentario
      <textarea name="mensaje" rows="3" required placeholder="Escribe una nota, pregunta o actualización..."></textarea>
    </label>
    <button class="btn btn-primario" type="submit">Comentar</button>
  </form>
</section>
<%- include('../partials/footer') %>
